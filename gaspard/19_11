# -----------------------------
# Chargement
# -----------------------------
data = np.load("GREV/inf-8245-fall-2025/train.npz")
X_train = data["X_train"].astype(np.float32)
y_train = data["y_train"]
ids = data["ids"]  # train ids

# Suppose que tu as aussi un fichier test.npz avec les mêmes clés
data_test = np.load("GREV/inf-8245-fall-2025/test.npz")
X_test = data_test["X_test"].astype(np.float32)
ids_test = data_test["ids"]


chunk_size = 10000
n_features = X_train.shape[1]

f_scores = np.zeros(n_features)
p_values = np.ones(n_features)

print(f"Calcul des scores F (ANOVA) sur {n_features} features en paquets de {chunk_size}...")

# === Boucle sur les features par blocs ===
for i in tqdm(range(0, n_features, chunk_size)):
    chunk = X_train[:, i:i + chunk_size]

    # Conversion en float32 (gain mémoire)
    chunk = chunk.astype(np.float32)

    # Calcul du F-score pour ce bloc
    scores, pvals = f_classif(chunk, y_train)

    # On stocke les résultats dans les bons emplacements
    f_scores[i:i + chunk.shape[1]] = scores
    p_values[i:i + chunk.shape[1]] = pvals

# === Sélection des meilleures features ===
k = 1500  # nombre de features à garder
sorted_indices = np.argsort(-f_scores)  # tri décroissant
top_indices = sorted_indices[:k]

print(f"\nSélection des {k:,} features les plus discriminantes...")

# === Réduction du jeu de données ===
X_train_reduced = X_train[:, top_indices]
X_test_reduced = X_test[:, top_indices]


# -----------------------------
# ACP
# -----------------------------
pca = PCA(n_components=500, svd_solver="randomized")
X_train_pca = pca.fit_transform(X_train_reduced)
X_test_pca  = pca.transform(X_test_reduced)
print("PCA terminée")

# -----------------------------
# Ajout des métadonnées pondérées
# -----------------------------
# Chargement
meta_train_df = pd.read_csv("GREV/inf-8245-fall-2025/metadata_train.csv")
meta_test_df  = pd.read_csv("GREV/inf-8245-fall-2025/metadata_test.csv")

# -----------------------------
# Suppression colonnes sans valeur prédictive
# -----------------------------
cols_to_drop = ["Organism group", "ID", "Create date"]  # adaptées à ton CSV
meta_train_df = meta_train_df.drop(columns=cols_to_drop, errors="ignore")
meta_test_df  = meta_test_df.drop(columns=cols_to_drop, errors="ignore")

# -----------------------------
# Détection num. / cat.
# -----------------------------
num_cols = meta_train_df.select_dtypes(include=[np.number]).columns.tolist()
cat_cols = meta_train_df.select_dtypes(exclude=[np.number]).columns.tolist()

# -----------------------------
# Imputation
# -----------------------------
imputer_num = SimpleImputer(strategy="median")
imputer_cat = SimpleImputer(strategy="most_frequent")

train_num = imputer_num.fit_transform(meta_train_df[num_cols])
test_num  = imputer_num.transform(meta_test_df[num_cols])

train_cat = imputer_cat.fit_transform(meta_train_df[cat_cols])
test_cat  = imputer_cat.transform(meta_test_df[cat_cols])

# -----------------------------
# Encodage catégoriel
# -----------------------------
# Encodage catégoriel uniquement si cat_cols n'est pas vide
if len(cat_cols) > 0:
    enc = OneHotEncoder(handle_unknown="ignore", sparse_output=False)
    train_cat_enc = enc.fit_transform(train_cat)
    test_cat_enc  = enc.transform(test_cat)
else:
    train_cat_enc = np.empty((meta_train_df.shape[0], 0), dtype=np.float32)
    test_cat_enc  = np.empty((meta_test_df.shape[0], 0), dtype=np.float32)

# -----------------------------
# Fusion métadonnées
# -----------------------------
# Encodage catégoriel uniquement si cat_cols n'est pas vide
meta_train_clean = np.hstack([train_num, train_cat_enc]).astype(np.float32)
meta_test_clean  = np.hstack([test_num, test_cat_enc]).astype(np.float32)

# -----------------------------
# Standardisation
# -----------------------------
scaler = StandardScaler()
meta_train_std = scaler.fit_transform(meta_train_clean)
meta_test_std  = scaler.transform(meta_test_clean)

# -----------------------------
# Pondération
# -----------------------------
var_pca = X_train_pca.var(axis=0).mean()
var_meta = meta_train_std.var(axis=0).mean()
w = np.sqrt(var_pca / var_meta) * 2  # pondération renforcée

meta_train_w = meta_train_std * w
meta_test_w  = meta_test_std * w

# -----------------------------
# Concaténation au bloc PCA
# -----------------------------
X_train_final = np.hstack([X_train_pca, meta_train_w])
X_test_final  = np.hstack([X_test_pca, meta_test_w])
print("concaténation terminée")

