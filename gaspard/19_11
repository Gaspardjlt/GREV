from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score


# -----------------------------
# Split train / validation
# -----------------------------
X_tr, X_val, y_tr, y_val = train_test_split(
    X_train_final, y_train,
    test_size=0.2,
    random_state=42,
    stratify=y_train
)

# -----------------------------
# Entraînement modèle sur split interne
# -----------------------------
model_val = XGBClassifier(
    **best_params,
    tree_method="hist",
    eval_metric="logloss",
    n_jobs=4
)

model_val.fit(X_tr, y_tr)

# -----------------------------
# Évaluation locale
# -----------------------------
y_val_pred = model_val.predict(X_val)
val_acc = accuracy_score(y_val, y_val_pred)
print("Validation accuracy interne :", val_acc)
# Validation accuracy interne : 0.8917525773195877


# -----------------------------
# Entraînement final avec meilleurs hyperparamètres
# -----------------------------
best_model = XGBClassifier(
    **best_params,
    tree_method="hist",
    eval_metric="logloss",
    n_jobs=4
)

best_model.fit(X_train_final, y_train)

# -----------------------------
# Prédiction sur test
# -----------------------------
y_pred = best_model.predict(X_test_final)

# -----------------------------
# Submission
# -----------------------------
