import optuna
import xgboost as xgb
from xgboost import XGBClassifier
from sklearn.model_selection import train_test_split
from sklearn.feature_selection import VarianceThreshold
from sklearn.metrics import f1_score, classification_report
from tqdm import tqdm
import numpy as np
import pandas as pd
import warnings

warnings.filterwarnings("ignore")

# ======================================================================
# 0. CHARGEMENT (Optimisé avec mmap)
# ======================================================================
print("Chargement des données...")
# Utilisation de mmap_mode='r' pour économiser la RAM
data = np.load("GREV/inf-8245-fall-2025/train.npz", mmap_mode='r')
data_test = np.load("GREV/inf-8245-fall-2025/test.npz", mmap_mode='r')

X_train_full = data['X_train']
y_train_full = data['y_train']

X_test_full = data_test['X_test']
ids_test = data_test['ids']

n_samples = y_train_full.shape[0]
n_features_init = X_train_full.shape[1]
CHUNK_SIZE = 100000

print(f"Dimensions Train : ({n_samples}, {n_features_init:,})")
print(f"Dimensions Test  : ({X_test_full.shape[0]}, {X_test_full.shape[1]:,})")
print("-" * 50)

# ======================================================================
# 1. FILTRAGE PAR VARIANCE (TRAIN & TEST)
# ======================================================================
print("1. Filtrage par Variance (threshold=0.01)...")

selector = VarianceThreshold(threshold=0.01)
selected_feature_indices = []

for i in tqdm(range(0, n_features_init, CHUNK_SIZE), desc="Analyse Variance Train"):
    chunk_end = min(i + CHUNK_SIZE, n_features_init)
    current_chunk = X_train_full[:, i:chunk_end]
    selector.fit(current_chunk)
    local_indices = selector.get_support(indices=True)
    global_indices = [idx + i for idx in local_indices]
    selected_feature_indices.extend(global_indices)
    del current_chunk

print("Application de la réduction...")
# Chargement en RAM des données réduites
X_train_reduced = np.array(X_train_full[:, selected_feature_indices])
X_test_reduced = np.array(X_test_full[:, selected_feature_indices])

print(f"Features restantes : {X_train_reduced.shape[1]:,}")

data.close()
data_test.close()

# ======================================================================
# 2. TRI DES FEATURES (TRAIN & TEST)
# ======================================================================
print("2. Tri des features par variance décroissante...")

variances = np.var(X_train_reduced, axis=0)
sorted_indices = np.argsort(variances)[::-1] 

X_train_sorted = X_train_reduced[:, sorted_indices]
X_test_sorted = X_test_reduced[:, sorted_indices]

print(f"Datasets triés. Shape Train: {X_train_sorted.shape}")
print("-" * 50)

# ======================================================================
# 3. OPTIMISATION OPTUNA (Essai 4 : Cible sur Essai 2)
# ======================================================================

def objective(trial):
    # A. Choix dynamique du nombre de features
    # On resserre vers le haut car les deux meilleurs essais étaient > 5600
    max_k = X_train_sorted.shape[1]
    k_features = trial.suggest_int('n_features', 5000, min(6000, max_k))
    
    # Slicing
    X_trial = X_train_sorted[:, :k_features]
    y_trial = y_train_full

    # B. Hyperparamètres (Centrés sur Essai 2)
    param = {
        # Essai 2 avait 500, on teste une plage modérée
        'n_estimators': trial.suggest_int('n_estimators', 400, 900),
        
        # Essai 2 (depth=6) > Essai 3 (depth=8). On reste modéré.
        'max_depth': trial.suggest_int('max_depth', 4, 7),
        
        # Le learning rate de l'essai 2 était ~0.06. On cherche autour.
        'learning_rate': trial.suggest_float('learning_rate', 0.03, 0.1),
        
        # CRITIQUE : On force l'échantillonnage autour de 0.5 (la clé du succès précédent)
        'subsample': trial.suggest_float('subsample', 0.4, 0.65),
        'colsample_bytree': trial.suggest_float('colsample_bytree', 0.4, 0.65),
        
        'min_child_weight': trial.suggest_int('min_child_weight', 1, 5),
        
        # On remonte la régularisation (Essai 2 était ~0.94 vs Essai 3 ~0.04)
        'reg_lambda': trial.suggest_float('reg_lambda', 0.5, 3.0),
        'reg_alpha': trial.suggest_float('reg_alpha', 1e-4, 1.0, log=True),
        'gamma': trial.suggest_float('gamma', 1e-4, 0.5, log=True),
        
        'objective': 'multi:softmax', 
        'num_class': len(np.unique(y_trial)), 
        'n_jobs': -1,
        'random_state': 42,
        'tree_method': 'hist',
        'eval_metric': "mlogloss",
        'early_stopping_rounds': 50 
    }

    # C. Split Stratifié
    X_tr, X_val, y_tr, y_val = train_test_split(
        X_trial, y_trial, test_size=0.2, random_state=42, stratify=y_trial
    )

    # D. Entraînement
    model = XGBClassifier(**param)
    model.fit(X_tr, y_tr, eval_set=[(X_val, y_val)], verbose=False)

    # E. Score & Rapport
    preds = model.predict(X_val)
    f1_macro = f1_score(y_val, preds, average='macro')
    
    print(f"\n=== Trial {trial.number} (F1: {f1_macro:.4f}) ===")
    print(f"Params: k={k_features}, depth={param['max_depth']}, sub={param['subsample']:.2f}, col={param['colsample_bytree']:.2f}, L2={param['reg_lambda']:.2f}")
    print("Classification Report:")
    print(classification_report(y_val, preds, digits=3))
    print("-" * 30)
    
    return f1_macro

# Lancement Optuna
# On lance 25 essais pour bien explorer cette zone prometteuse
study = optuna.create_study(direction='maximize', study_name="XGBoost_Essai4")
print("3. Recherche des hyperparamètres (Stratégie: Raffinement Essai 2)...")
study.optimize(objective, n_trials=25, show_progress_bar=True) 

print("-" * 50)
print(f"Meilleur F1 validé : {study.best_value:.4f}")
print("Meilleurs paramètres trouvés :")
for key, value in study.best_params.items():
    print(f"  {key}: {value}")
print("-" * 50)

# ======================================================================
# 4. ENTRAINEMENT FINAL & SOUMISSION
# ======================================================================
print("4. Génération de la soumission...")

best_params = study.best_params.copy()
best_k = best_params.pop('n_features')

X_train_final = X_train_sorted[:, :best_k]
X_test_final = X_test_sorted[:, :best_k]

final_model = XGBClassifier(
    **best_params,
    objective='multi:softmax',
    num_class=len(np.unique(y_train_full)),
    n_jobs=-1,
    random_state=42,
    tree_method='hist'
)

print(f"-> Entraînement sur tout le dataset ({n_samples} samples, {best_k} features)...")
final_model.fit(X_train_final, y_train_full)

print("-> Prédictions sur le test...")
test_predictions = final_model.predict(X_test_final)

submission = pd.DataFrame({
    'Id': ids_test,
    'Category': test_predictions.astype(int)
})

filename = f"submission_xgboost_essai4.csv"
submission.to_csv(filename, index=False)
print(f"Fichier '{filename}' généré avec succès !")